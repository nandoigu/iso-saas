# Test database — Neon branch "test"
# Copy this file to .env.test and fill in your Neon test branch URL
# Never use the production DATABASE_URL here

TEST_DATABASE_URL=postgresql://neondb_owner:<password>@<test-branch-host>/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://neondb_owner:<password>@<test-branch-host>/neondb?sslmode=require&channel_binding=require

# Auth secret (puede ser el mismo que producción para tests)
AUTH_SECRET=test-secret-change-me
