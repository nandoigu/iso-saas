# Email configuration
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
AUTH_SECRET=replace-with-a-long-random-session-secret
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Fase 1: remitente de prueba mientras no tengas dominio verificado
# EMAIL_FROM="BMO ISO 19650 <onboarding@resend.dev>"

# Fase 2: remitente de produccion con dominio propio verificado en Resend
EMAIL_FROM="BMO ISO 19650 <no-reply@midominio.com>"

# Cron protection for scheduled alerts
CRON_SECRET=replace-with-a-long-random-secret
