generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())

  users      User[]
  projects   Project[]
  auditors   Auditor[]
  auditTeams AuditTeam[]
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String
  role            String    @default("user")
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  notifyAlerts    Boolean   @default(true)
  notifyReports   Boolean   @default(false)
  reportFrequency String    @default("weekly")
  lastAlertEmailAt DateTime?
  lastReportEmailAt DateTime?

  companyId           String?
  company             Company?             @relation(fields: [companyId], references: [id])
  projects            Project[]
  passwordResetTokens PasswordResetToken[]
  auditReports        AuditReport[]
  auditorProfile      Auditor?
}

model Project {
  id        String   @id @default(cuid())
  name      String
  code      String?
  role      String   @default("adjudicatario")
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  requirements Requirement[]
  auditReports AuditReport[]
  auditTeams   AuditTeam[]
}

model Requirement {
  id        String    @id @default(cuid())
  name      String
  titulo    String    @default("")
  descripcion String  @default("")
  norma     String?
  item      String?
  evidencia String?
  status    String
  completed Boolean   @default(false)
  deadline  DateTime?
  lastNotifiedAt DateTime?
  createdAt DateTime  @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  templateId String?
  template   RequirementTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([projectId, templateId])
}

model RequirementTemplate {
  id            String    @id @default(cuid())
  norma         String
  item          String
  name          String
  titulo        String    @default("")
  descripcion   String    @default("")
  role          String    @default("general")
  evidencia     String?
  defaultStatus String    @default("no_conforme")
  deadline      DateTime?
  createdAt     DateTime  @default(now())

  requirements  Requirement[]

  @@unique([norma, item, titulo, descripcion, role])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditReport {
  id                 String   @id @default(cuid())
  auditId            String
  reportNumber       String
  version            Int      @default(1)
  status             String   @default("draft")
  auditType          String
  scope              String
  auditedOrgName     String
  auditedOrgAddress  String?
  auditedOrgRep      String?
  leadAuditor        String
  auditors           Json
  technicalExperts   Json
  auditStartDate     DateTime
  auditEndDate       DateTime
  reportDate         DateTime
  applicableStandards Json
  sourceData         Json
  generatedContent   Json
  traceability       Json
  complianceScore    Int
  maturityScore      Int
  riskScore          Int
  confidenceScore    Int
  globalStatus       String
  finalOpinion       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  auditTeamId String?
  auditTeam   AuditTeam? @relation(fields: [auditTeamId], references: [id], onDelete: SetNull)

  versions AuditReportVersion[]

  @@unique([reportNumber, version])
  @@index([projectId])
  @@index([createdById])
  @@index([auditId])
}

model AuditReportVersion {
  id               String   @id @default(cuid())
  version          Int
  status           String
  snapshot         Json
  traceability     Json
  complianceScore  Int
  maturityScore    Int
  riskScore        Int
  confidenceScore  Int
  globalStatus     String
  finalOpinion     String
  createdAt        DateTime @default(now())

  reportId String
  report   AuditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdById String

  @@unique([reportId, version])
  @@index([createdById])
}

model Auditor {
  id                  String   @id @default(cuid())
  companyId           String
  userId              String?  @unique
  name                String
  email               String
  phone               String?
  certificationBody   String?
  certificationNumber String?
  certificationLevel  String?
  qualifications      String[] @default([])
  isExternal          Boolean  @default(false)
  status              String   @default("active")
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdById         String

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments AuditTeamMember[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([userId])
}

model AuditTeam {
  id          String   @id @default(cuid())
  companyId   String
  projectId   String
  auditId     String
  name        String?
  status      String   @default("forming")
  formedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project  Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  members  AuditTeamMember[]
  reports  AuditReport[]

  @@index([companyId])
  @@index([projectId])
  @@index([auditId])
}

model AuditTeamMember {
  id              String    @id @default(cuid())
  auditTeamId     String
  auditorId       String
  role            String
  status          String    @default("invited")
  assignedAt      DateTime  @default(now())
  confirmedAt     DateTime?
  withdrawnAt     DateTime?
  withdrawnReason String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String

  auditTeam AuditTeam @relation(fields: [auditTeamId], references: [id], onDelete: Cascade)
  auditor   Auditor   @relation(fields: [auditorId], references: [id], onDelete: Restrict)

  @@unique([auditTeamId, auditorId])
  @@index([auditTeamId])
  @@index([auditorId])
}
