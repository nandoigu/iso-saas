generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  code      String
  createdAt DateTime @default(now())

  requirements Requirement[]
}

model Requirement {
  id        String    @id @default(cuid())
  name      String
  norma     String?
  item      String?
  evidencia String?
  status    String
  completed Boolean   @default(false)
  deadline  DateTime?
  createdAt DateTime  @default(now())

  // 🔗 RELACIÓN CORRECTA
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}
