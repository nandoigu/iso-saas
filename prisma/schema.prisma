generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users      User[]
  projects   Project[]
  auditors   Auditor[]
  auditTeams AuditTeam[]
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  password          String
  role              String    @default("user")
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  notifyAlerts      Boolean   @default(true)
  notifyReports     Boolean   @default(false)
  reportFrequency   String    @default("weekly")
  lastAlertEmailAt  DateTime?
  lastReportEmailAt DateTime?

  companyId           String?
  company             Company?             @relation(fields: [companyId], references: [id])
  projects            Project[]
  passwordResetTokens PasswordResetToken[]
  auditReports        AuditReport[]
  auditorProfile      Auditor?

  evidenceItemsCreated     EvidenceItem[]            @relation("EvidenceCreator")
  evidenceLinksAdded       EvidenceRequirementLink[] @relation("EvidenceLinkAdder")
  evidenceLinksValidated   EvidenceRequirementLink[] @relation("EvidenceLinkValidator")
  evidenceReportLinksAdded EvidenceReportLink[]      @relation("ReportLinkAdder")
  evidenceValidations      EvidenceValidation[]      @relation("EvidenceValidator")
  evidenceVersionsCreated  EvidenceItemVersion[]     @relation("EvidenceVersionCreator")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  code      String?
  role      String   @default("adjudicatario")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  requirements  Requirement[]
  auditReports  AuditReport[]
  auditTeams    AuditTeam[]
  evidenceItems EvidenceItem[]
}

model Requirement {
  id             String    @id @default(cuid())
  name           String
  titulo         String    @default("")
  descripcion    String    @default("")
  norma          String?
  item           String?
  evidencia      String?
  status         String
  completed      Boolean   @default(false)
  deadline       DateTime?
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  templateId String?
  template   RequirementTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  evidenceLinks EvidenceRequirementLink[]

  @@unique([projectId, templateId])
}

model RequirementTemplate {
  id            String    @id @default(cuid())
  norma         String
  item          String
  name          String
  titulo        String    @default("")
  descripcion   String    @default("")
  role          String    @default("general")
  evidencia     String?
  // ADR-013: criterio de aceptacion escrito por el experto, quinta columna del Excel
  // de docs/fuentes/. NO se reutiliza el campo legado `evidencia`.
  criterioAceptacion String?
  defaultStatus String    @default("no_conforme")
  deadline      DateTime?
  createdAt     DateTime  @default(now())

  requirements Requirement[]

  @@unique([norma, item, titulo, descripcion, role])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditReport {
  id                  String   @id @default(cuid())
  auditId             String
  reportNumber        String
  version             Int      @default(1)
  status              String   @default("draft")
  auditType           String
  scope               String
  auditedOrgName      String
  auditedOrgAddress   String?
  auditedOrgRep       String?
  leadAuditor         String
  auditors            Json
  technicalExperts    Json
  auditStartDate      DateTime
  auditEndDate        DateTime
  reportDate          DateTime
  applicableStandards Json
  sourceData          Json
  generatedContent    Json
  traceability        Json
  complianceScore     Int
  maturityScore       Int
  riskScore           Int
  confidenceScore     Int
  globalStatus        String
  finalOpinion        String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  auditTeamId String?
  auditTeam   AuditTeam? @relation(fields: [auditTeamId], references: [id], onDelete: SetNull)

  versions      AuditReportVersion[]
  evidenceLinks EvidenceReportLink[]

  @@unique([reportNumber, version])
  @@index([projectId])
  @@index([createdById])
  @@index([auditId])
}

model AuditReportVersion {
  id              String   @id @default(cuid())
  version         Int
  status          String
  snapshot        Json
  traceability    Json
  complianceScore Int
  maturityScore   Int
  riskScore       Int
  confidenceScore Int
  globalStatus    String
  finalOpinion    String
  createdAt       DateTime @default(now())

  reportId String
  report   AuditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdById String

  @@unique([reportId, version])
  @@index([createdById])
}

model Auditor {
  id                  String   @id @default(cuid())
  companyId           String
  userId              String?  @unique
  name                String
  email               String
  phone               String?
  certificationBody   String?
  certificationNumber String?
  certificationLevel  String?
  qualifications      String[] @default([])
  isExternal          Boolean  @default(false)
  status              String   @default("active")
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdById         String

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments AuditTeamMember[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([userId])
}

model AuditTeam {
  id          String   @id @default(cuid())
  companyId   String
  projectId   String
  auditId     String
  name        String?
  status      String   @default("forming")
  formedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  company Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  members AuditTeamMember[]
  reports AuditReport[]

  @@index([companyId])
  @@index([projectId])
  @@index([auditId])
}

model AuditTeamMember {
  id              String    @id @default(cuid())
  auditTeamId     String
  auditorId       String
  role            String
  status          String    @default("invited")
  assignedAt      DateTime  @default(now())
  confirmedAt     DateTime?
  withdrawnAt     DateTime?
  withdrawnReason String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String

  auditTeam AuditTeam @relation(fields: [auditTeamId], references: [id], onDelete: Cascade)
  auditor   Auditor   @relation(fields: [auditorId], references: [id], onDelete: Restrict)

  @@unique([auditTeamId, auditorId])
  @@index([auditTeamId])
  @@index([auditorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EVIDENCE GRAPH — Core entity
// ─────────────────────────────────────────────────────────────────────────────

model EvidenceItem {
  id          String   @id @default(cuid())
  projectId   String // tenant isolation via project → company
  title       String
  description String   @default("")
  type        String // "document" | "record" | "declaration"
  sourceRef   String? // URL, file path, or external reference ID
  status      String   @default("draft") // "draft" | "submitted" | "under_review" | "validated" | "rejected" | "archived"
  version     Int      @default(1) // incremented on each content change
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String // userId
  updatedBy   String? // userId — last modifier

  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creator          User                      @relation("EvidenceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  requirementLinks EvidenceRequirementLink[]
  reportLinks      EvidenceReportLink[]
  validations      EvidenceValidation[]
  versions         EvidenceItemVersion[]

  @@index([projectId])
  @@index([createdBy])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// EVIDENCE GRAPH — Many-to-many: EvidenceItem ↔ Requirement
// ─────────────────────────────────────────────────────────────────────────────

model EvidenceRequirementLink {
  id             String   @id @default(cuid())
  evidenceItemId String
  requirementId  String
  linkType       String   @default("supporting") // "primary" | "supporting" | "contradictory"
  addedAt        DateTime @default(now())
  addedBy        String // userId
  // ADR-010: declarar el vinculo es del dueno del proyecto; validarlo, del auditor.
  // Nulos mientras nadie lo haya validado.
  validatedAt    DateTime?
  validatedBy    String? // userId del auditor que valida

  evidenceItem EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  requirement  Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  addedByUser  User         @relation("EvidenceLinkAdder", fields: [addedBy], references: [id], onDelete: Restrict)
  validatedByUser User?    @relation("EvidenceLinkValidator", fields: [validatedBy], references: [id], onDelete: Restrict)

  @@unique([evidenceItemId, requirementId])
  @@index([evidenceItemId])
  @@index([requirementId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EVIDENCE GRAPH — Many-to-many: EvidenceItem ↔ AuditReport (traceability)
// ─────────────────────────────────────────────────────────────────────────────

model EvidenceReportLink {
  id             String   @id @default(cuid())
  evidenceItemId String
  auditReportId  String
  usedAs         String   @default("supporting") // "supporting" | "conclusion_basis" | "referenced"
  addedAt        DateTime @default(now())
  addedBy        String // userId

  evidenceItem EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  auditReport  AuditReport  @relation(fields: [auditReportId], references: [id], onDelete: Cascade)
  addedByUser  User         @relation("ReportLinkAdder", fields: [addedBy], references: [id], onDelete: Restrict)

  @@unique([evidenceItemId, auditReportId])
  @@index([evidenceItemId])
  @@index([auditReportId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EVIDENCE GRAPH — Human-in-the-loop validation trail
// ─────────────────────────────────────────────────────────────────────────────

model EvidenceValidation {
  id             String   @id @default(cuid())
  evidenceItemId String
  outcome        String // "approved" | "rejected" | "pending_clarification"
  notes          String   @default("")
  validatedAt    DateTime @default(now())
  validatedBy    String // userId

  evidenceItem EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  validator    User         @relation("EvidenceValidator", fields: [validatedBy], references: [id], onDelete: Restrict)

  @@index([evidenceItemId])
  @@index([validatedBy])
}

// ─────────────────────────────────────────────────────────────────────────────
// EVIDENCE GRAPH — Governance snapshot (follows AuditReport/AuditReportVersion pattern)
// ─────────────────────────────────────────────────────────────────────────────

model EvidenceItemVersion {
  id             String   @id @default(cuid())
  evidenceItemId String
  version        Int
  snapshot       Json // full EvidenceItem state at this version
  changeReason   String   @default("") // why this version was created
  createdAt      DateTime @default(now())
  createdBy      String // userId

  evidenceItem EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  creator      User         @relation("EvidenceVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([evidenceItemId, version])
  @@index([evidenceItemId])
}
