generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())

  users     User[]
  projects  Project[]
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  role      String    @default("user")
  createdAt DateTime  @default(now())
  notifyAlerts Boolean @default(true)
  notifyReports Boolean @default(false)
  reportFrequency String @default("weekly")
  lastAlertEmailAt DateTime?
  lastReportEmailAt DateTime?

  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  projects  Project[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  code      String?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  requirements Requirement[]
}

model Requirement {
  id        String    @id @default(cuid())
  name      String
  norma     String?
  item      String?
  evidencia String?
  status    String
  completed Boolean   @default(false)
  deadline  DateTime?
  lastNotifiedAt DateTime?
  createdAt DateTime  @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

model RequirementTemplate {
  id            String    @id @default(cuid())
  norma         String
  item          String
  name          String
  evidencia     String?
  defaultStatus String    @default("no_conforme")
  deadline      DateTime?
  createdAt     DateTime  @default(now())

  @@unique([norma, item, name])
}
